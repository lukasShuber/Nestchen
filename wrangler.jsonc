{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name must match the name you give the Worker in the Cloudflare dashboard.
  "name": "nestchen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Everything that is not an API call or calendar feed is the single-page app.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cal/*"]
  },
  // No database_id needed: Cloudflare creates the database on the first deploy.
  // The Worker creates and upgrades its own tables on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "nestchen-db" }],
  "observability": { "enabled": true }
}
