{
  "name": "nestchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A small, private organiser for new parents: visits, meal train, wishlist, calendar and lists.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "types": "wrangler types src/worker/worker-configuration.d.ts",
    "seed": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "hono": "^4.13.11",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
